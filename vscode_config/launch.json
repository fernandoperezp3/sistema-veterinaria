{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: runserver",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["runserver", "127.0.0.1:8080"],
            "django": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Microservicios (8081-8084)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/microservicios/orchestrator.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Cargar datos demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/poblar_datos.py",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Sistema completo (Django + Microservicios)",
            "configurations": ["Microservicios (8081-8084)", "Django: runserver"],
            "stopAll": true
        }
    ]
}
